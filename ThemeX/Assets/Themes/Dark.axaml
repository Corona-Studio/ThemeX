<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BoxShadows x:Key="ThemeX.DefaultShadow">4 4 10 0 #313131</BoxShadows>

    <SolidColorBrush x:Key="ThemeX.Foreground.Error" Color="#f50057" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Danger" Color="#f50057" />

    <SolidColorBrush x:Key="ThemeX.Foreground.Primary" Color="#F2F2F7" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Secondary" Color="#C7C7CC" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Tertiary" Color="#7C7C80" />

    <SolidColorBrush x:Key="ThemeX.Transparent.Total" Color="#00000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Primary" Color="#59000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Secondary" Color="#8C000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Tertiary" Color="#BF000000" />

    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Primary" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Secondary" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Tertiary" Color="#BFFFFFFF" />

    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Primary" Color="#000000" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Secondary" Color="#1b1b1b" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Tertiary" Color="#373737" />

    <SolidColorBrush x:Key="ThemeX.BorderBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.MouseOver" Color="#8a8886" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Pressed" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse" Color="#0078D4" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse.MouseOver" Color="#FF3C7FB1" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse.Pressed" Color="#FF2C628B" />

    <SolidColorBrush x:Key="ThemeX.ContentBackground" Color="#FF1b1b1b" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Primary" Color="#000000" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Secondary" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Tertiary" Color="#FF373737" />

    <Color x:Key="ThemeX.ContentBackground.Media">#FF212121</Color>
    <Color x:Key="ThemeX.ContentBackground.Primary.Media">#000000</Color>
    <Color x:Key="ThemeX.ContentBackground.Secondary.Media">#FF3C3C3C</Color>
    <Color x:Key="ThemeX.ContentBackground.Tertiary.Media">#FF373737</Color>

    <SolidColorBrush x:Key="ThemeX.ButtonBackground" Color="#303030" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.MouseOver" Color="#000000" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Pressed" Color="#FF727272" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary" Color="DarkGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary.MouseOver" Color="DarkGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary.Pressed" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary.MouseOver" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary.Pressed" Color="#FFB8B8B8" />

    <SolidColorBrush x:Key="ThemeX.Placeholder" Color="#FFA0A0A0" />

    <Color x:Key="LauncherX.Notify.Hover">#19FFFFFF</Color>
    <Color x:Key="ThemeX.Transparent.Reverse.Tertiary.Color">#BFFFFFFF</Color>
</ResourceDictionary>