<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Fluent 2 Elevation Shadows  -->
    <BoxShadows x:Key="ThemeX.DefaultShadow">0 8 16 0 #42000000, 0 2 4 0 #26000000</BoxShadows>
    <BoxShadows x:Key="ThemeX.Shadow.Card">0 2 4 0 #26000000</BoxShadows>
    <BoxShadows x:Key="ThemeX.Shadow.Flyout">0 8 16 0 #42000000, 0 2 4 0 #26000000</BoxShadows>
    <BoxShadows x:Key="ThemeX.Shadow.Dialog">0 32 64 0 #5E000000, 0 2 21 0 #40000000</BoxShadows>

    <!--  Semantic Status Foregrounds (GetGrayLevel < 0.5 for Error so badges keep white foreground)  -->
    <SolidColorBrush x:Key="ThemeX.Foreground.Error" Color="#FF454E" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Danger" Color="#FF454E" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Warning" Color="#FCE100" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Info" Color="#60CDFF" />

    <!--  Fluent 2 Text Hierarchy  -->
    <SolidColorBrush x:Key="ThemeX.Foreground.Primary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Secondary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Tertiary" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Disabled" Color="#78FFFFFF" />

    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Primary" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Secondary" Color="#FF282828" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Tertiary" Color="#FF383838" />

    <SolidColorBrush x:Key="ThemeX.Placeholder" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Focus.OuterBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Focus.InnerBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="ThemeX.HaloBrush" Color="#18FFFFFF" />

    <!--  Translucent Helpers (backwards-compatible)  -->
    <SolidColorBrush x:Key="ThemeX.Transparent.Total" Color="#00000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Primary" Color="#59000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Secondary" Color="#8C000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Tertiary" Color="#BF000000" />

    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Primary" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Secondary" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Tertiary" Color="#BFFFFFFF" />
    <Color x:Key="ThemeX.Transparent.Reverse.Tertiary.Color">#BFFFFFFF</Color>

    <!--  Fluent 2 Surface & Layer Hierarchy  -->
    <SolidColorBrush x:Key="ThemeX.Surface.Canvas" Color="#FF202020" />
    <SolidColorBrush x:Key="ThemeX.Surface.Layer" Color="#803A3A3A" />
    <SolidColorBrush x:Key="ThemeX.Surface.LayerAlt" Color="#FF272727" />
    <SolidColorBrush x:Key="ThemeX.Surface.Card" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.CardSecondary" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.SubtleHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.SubtlePressed" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.Control" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.ControlHover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.ControlPressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.ControlDisabled" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Surface.ControlInputActive" Color="#B31E1E1E" />
    <SolidColorBrush x:Key="ThemeX.Surface.Smoke" Color="#66000000" />

    <!--  Fluent 2 Acrylic & Backdrop Fallback Surfaces  -->
    <SolidColorBrush x:Key="ThemeX.Acrylic.Surface" Color="#C4242424" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.SurfaceFallback" Color="#FF242424" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.Flyout" Color="#D82B2B2B" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.FlyoutFallback" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.Card" Color="#B02B2B2B" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.CardFallback" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.Subtle" Color="#99202020" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.SubtleFallback" Color="#FF202020" />

    <!--  Fluent 2 Acrylic Luminosity, Sheen & Specular Bevel Layers  -->
    <SolidColorBrush x:Key="ThemeX.Acrylic.Luminosity.Surface" Color="#33202020" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.Luminosity.Flyout" Color="#40262626" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.Luminosity.Card" Color="#26242424" />
    <SolidColorBrush x:Key="ThemeX.Acrylic.Luminosity.Subtle" Color="#1A1A1A1A" />
    <LinearGradientBrush x:Key="ThemeX.Acrylic.SpecularBevel" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="0.08" Color="#10FFFFFF" />
        <GradientStop Offset="0.35" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeX.Acrylic.NoiseTint" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#0CFFFFFF" />
        <GradientStop Offset="0.5" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#06FFFFFF" />
    </LinearGradientBrush>

    <!--  Fluent Reveal Highlight Tokens (whisper-quiet hairline edge glint + calm glass sheen)  -->
    <Color x:Key="ThemeX.Reveal.BorderColor">#38FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.BorderMidColor">#16FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.HoverColor">#0DFFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.HoverMidColor">#04FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.PressedColor">#16FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.AccentBorderColor">#48FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.AccentBorderMidColor">#1AFFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.AccentHoverColor">#14FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.AccentHoverMidColor">#05FFFFFF</Color>
    <Color x:Key="ThemeX.Reveal.AccentPressedColor">#1EFFFFFF</Color>

    <!--  Fluent 2 Strokes & Specular Elevation Borders  -->
    <SolidColorBrush x:Key="ThemeX.Stroke.Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Stroke.Divider" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Separator" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Stroke.Control" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Stroke.ControlStrong" Color="#8BFFFFFF" />

    <LinearGradientBrush x:Key="ThemeX.Stroke.SurfaceFlyout" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#26FFFFFF" />
        <GradientStop Offset="0.2" Color="#16FFFFFF" />
        <GradientStop Offset="1" Color="#12FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeX.Elevation.ControlBorder" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#18FFFFFF" />
        <GradientStop Offset="0.16" Color="#0FFFFFFF" />
        <GradientStop Offset="1" Color="#0FFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeX.Elevation.ControlBorderHover" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#22FFFFFF" />
        <GradientStop Offset="0.16" Color="#15FFFFFF" />
        <GradientStop Offset="1" Color="#15FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeX.Elevation.CircleBorder" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#24FFFFFF" />
        <GradientStop Offset="0.5" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#14FFFFFF" />
    </LinearGradientBrush>

    <!--  Legacy Border Aliases (refined to Fluent 2)  -->
    <SolidColorBrush x:Key="ThemeX.BorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.MouseOver" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Pressed" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse.MouseOver" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse.Pressed" Color="#18FFFFFF" />

    <!--  Legacy ContentBackground Aliases (refined to Fluent 2 dark grays)  -->
    <SolidColorBrush x:Key="ThemeX.ContentBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Primary" Color="#FF272727" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Secondary" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Tertiary" Color="#FF323232" />

    <Color x:Key="ThemeX.ContentBackground.Media">#FF202020</Color>
    <Color x:Key="ThemeX.ContentBackground.Primary.Media">#FF272727</Color>
    <Color x:Key="ThemeX.ContentBackground.Secondary.Media">#FF2C2C2C</Color>
    <Color x:Key="ThemeX.ContentBackground.Tertiary.Media">#FF323232</Color>

    <!--  Legacy ButtonBackground Aliases (refined to Fluent 2)  -->
    <SolidColorBrush x:Key="ThemeX.ButtonBackground" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.MouseOver" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Pressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary.MouseOver" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary.Pressed" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary.MouseOver" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary.Pressed" Color="#14FFFFFF" />

    <Color x:Key="LauncherX.Notify.Hover">#19FFFFFF</Color>

</ResourceDictionary>
