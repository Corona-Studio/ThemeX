<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BoxShadows x:Key="ThemeX.DefaultShadow">4 4 10 0 #70717171</BoxShadows>

    <SolidColorBrush x:Key="ThemeX.Foreground.Error" Color="#ff1744" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Danger" Color="#ff1744" />

    <SolidColorBrush x:Key="ThemeX.Foreground.Primary" Color="#000000" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Secondary" Color="#1b1b1b" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Tertiary" Color="#373737" />

    <SolidColorBrush x:Key="ThemeX.Transparent.Total" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Primary" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Secondary" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Tertiary" Color="#BFFFFFFF" />

    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Primary" Color="#59000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Secondary" Color="#8C000000" />
    <SolidColorBrush x:Key="ThemeX.Transparent.Reverse.Tertiary" Color="#BF000000" />

    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Primary" Color="#fafafa" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Secondary" Color="#f5f5f5" />
    <SolidColorBrush x:Key="ThemeX.Foreground.Reverse.Tertiary" Color="#eeeeee" />

    <SolidColorBrush x:Key="ThemeX.BorderBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.MouseOver" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Pressed" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse" Color="#8a8886" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse.MouseOver" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.BorderBrush.Reverse.Pressed" Color="#FFB8B8B8" />

    <SolidColorBrush x:Key="ThemeX.ContentBackground" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Primary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Secondary" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="ThemeX.ContentBackground.Tertiary" Color="#FFE2E2E2" />

    <SolidColorBrush x:Key="ThemeX.ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.MouseOver" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Pressed" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary.MouseOver" Color="LightGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Secondary.Pressed" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary" Color="DarkGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary.MouseOver" Color="DarkGray" />
    <SolidColorBrush x:Key="ThemeX.ButtonBackground.Primary.Pressed" Color="#FFB8B8B8" />

    <SolidColorBrush x:Key="ThemeX.Placeholder" Color="#FF606060" />

    <Color x:Key="ThemeX.ContentBackground.Media">#FFF7F7F7</Color>
    <Color x:Key="ThemeX.ContentBackground.Primary.Media">#FFFFFFFF</Color>
    <Color x:Key="ThemeX.ContentBackground.Secondary.Media">#FFEEEEEE</Color>
    <Color x:Key="ThemeX.ContentBackground.Tertiary.Media">#FFE2E2E2</Color>
    <Color x:Key="ThemeX.Transparent.Reverse.Tertiary.Color">#BF000000</Color>

</ResourceDictionary>