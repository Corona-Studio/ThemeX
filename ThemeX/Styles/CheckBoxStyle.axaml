<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks"
    xmlns:themeX="clr-namespace:ThemeX">

    <Thickness x:Key="CheckBoxBorderThickness">1</Thickness>
    <x:Double x:Key="CheckBoxSize">20</x:Double>
    <x:Double x:Key="CheckBoxGlyphSize">12</x:Double>
    <x:Double x:Key="CheckBoxHeight">32</x:Double>
    <x:Double x:Key="CheckBoxMinWidth">20</x:Double>
    <Thickness x:Key="CheckBoxPadding">8,0,0,0</Thickness>
    <x:String x:Key="CheckBoxCheckedGlyph">&#xE001;</x:String>
    <x:String x:Key="CheckBoxIndeterminateGlyph">&#xE004;</x:String>

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="Padding" Value="{StaticResource CheckBoxPadding}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource CheckBoxMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource CheckBoxHeight}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel
                            Grid.Column="0"
                            Height="{StaticResource CheckBoxHeight}"
                            VerticalAlignment="Center">
                            <Border
                                Name="NormalRectangle"
                                Width="{StaticResource CheckBoxSize}"
                                Height="{StaticResource CheckBoxSize}"
                                Background="{DynamicResource ThemeX.Surface.Control}"
                                BorderBrush="{DynamicResource ThemeX.Stroke.ControlStrong}"
                                BorderThickness="{StaticResource CheckBoxBorderThickness}"
                                CornerRadius="4"
                                RenderTransform="scale(1)"
                                RenderTransformOrigin="50%,50%">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.12" />
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                                        <TransformOperationsTransition
                                            Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                            Property="RenderTransform"
                                            Duration="0:0:0.083" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>

                            <iconPacks:IconPack
                                x:Name="CheckGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource CheckBoxGlyphSize}"
                                Foreground="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}"
                                Opacity="0"
                                RenderTransform="scale(0.65)"
                                RenderTransformOrigin="50%,50%"
                                Symbol="{StaticResource CheckBoxCheckedGlyph}">
                                <iconPacks:IconPack.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                        <TransformOperationsTransition
                                            Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                            Property="RenderTransform"
                                            Duration="0:0:0.15" />
                                    </Transitions>
                                </iconPacks:IconPack.Transitions>
                            </iconPacks:IconPack>
                        </Panel>

                        <ContentPresenter
                            Name="ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!--  Empty Content  -->
        <Style Selector="^ /template/ ContentPresenter#ContentPresenter:empty">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!--  Unchecked PointerOver  -->
        <Style Selector="^:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Foreground.Secondary}" />
        </Style>

        <!--  Unchecked Pressed  -->
        <Style Selector="^:pressed /template/ Border#NormalRectangle">
            <Setter Property="RenderTransform" Value="scale(0.94)" />
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>

        <!--  Checked  -->
        <Style Selector="^:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>
        <Style Selector="^:checked /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Symbol" Value="{StaticResource CheckBoxCheckedGlyph}" />
        </Style>

        <!--  Checked PointerOver  -->
        <Style Selector="^:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
        </Style>

        <!--  Checked Pressed  -->
        <Style Selector="^:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
        </Style>
        <Style Selector="^:checked:pressed /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="RenderTransform" Value="scale(0.88)" />
        </Style>

        <!--  Indeterminate  -->
        <Style Selector="^:indeterminate /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>
        <Style Selector="^:indeterminate /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Symbol" Value="{StaticResource CheckBoxIndeterminateGlyph}" />
        </Style>

        <Style Selector="^:indeterminate:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
        </Style>
        <Style Selector="^:indeterminate:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
        </Style>

        <!--  Disabled  -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlDisabled}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:disabled /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
