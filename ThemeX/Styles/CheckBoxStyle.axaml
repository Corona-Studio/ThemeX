<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks"
    xmlns:themeX="clr-namespace:ThemeX">
    <Design.PreviewWith>
        <Border Padding="50">
            <StackPanel Spacing="5">
                <CheckBox Content="CheckBox" />
                <CheckBox Content="CheckBox" IsChecked="True" />
                <CheckBox Content="CheckBox" IsChecked="{x:Null}" />
                <CheckBox Content="CheckBox" IsEnabled="False" />
                <CheckBox
                    Content="CheckBox"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Thickness x:Key="CheckBoxBorderThickness">1</Thickness>
    <x:Double x:Key="CheckBoxSize">20</x:Double>
    <x:Double x:Key="CheckBoxGlyphSize">12</x:Double>
    <x:Double x:Key="CheckBoxHeight">32</x:Double>
    <x:Double x:Key="CheckBoxMinWidth">12</x:Double>
    <Thickness x:Key="CheckBoxPadding">8,5,0,0</Thickness>
    <Thickness x:Key="CheckBoxFocusVisualMargin">-7,-3,-7,-3</Thickness>
    <x:String x:Key="CheckBoxCheckedGlyph">&#xE001;</x:String>
    <x:String x:Key="CheckBoxIndeterminateGlyph">&#xE004;</x:String>

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherX.Foreground.Primary}" />
        <Setter Property="Padding" Value="{StaticResource CheckBoxPadding}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource CheckBoxMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource CheckBoxHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">

                    <Grid ColumnDefinitions="Auto,*">

                        <Panel
                            Grid.Column="0"
                            Height="{StaticResource CheckBoxHeight}"
                            VerticalAlignment="Top">

                            <Border
                                Name="NormalRectangle"
                                Width="{StaticResource CheckBoxSize}"
                                Height="{StaticResource CheckBoxSize}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                UseLayoutRounding="False" />

                            <iconPacks:IconPack
                                x:Name="CheckGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource CheckBoxGlyphSize}"
                                Foreground="{Binding ElementName=NormalRectangle, Path=Background, Converter={StaticResource GreyLevelToForegroundConverter}}" />

                        </Panel>

                        <ContentPresenter
                            Name="ContentPresenter"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>

        <!--  Default / Unchecked Normal  -->
        <Style Selector="^ /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherX.BorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource CheckBoxBorderThickness}" />
        </Style>

        <Style Selector="^ /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlpyhForegroundUnchecked}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Symbol" Value="{DynamicResource CheckBoxCheckedGlyph}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Primary}" />
        </Style>

        <!--  Unchecked pointerover  -->
        <Style Selector="^:pointerover /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Secondary}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource LauncherX.ContentBackground.Secondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherX.BorderBrush.MouseOver}" />
        </Style>

        <Style Selector="^:pointerover /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundUncheckedPointerOver}" />
        </Style>

        <!--  Unchecked pressed  -->
        <Style Selector="^:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource LauncherX.ContentBackground.Tertiary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherX.BorderBrush.Pressed}" />
        </Style>

        <Style Selector="^:pressed /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundUncheckedPressed}" />
        </Style>

        <!--  Unchecked disabled  -->
        <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Tertiary}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource LauncherX.Transparent.Reverse.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherX.Foreground.Reverse.Primary}" />
        </Style>

        <!--  Checked Normal  -->
        <Style Selector="^:checked /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:checked /template/ Border#NormalRectangle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>

        <Style Selector="^:checked /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Symbol" Value="{DynamicResource CheckBoxCheckedGlyph}" />
        </Style>

        <!--  Checked pointerover  -->
        <Style Selector="^:checked:pointerover /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>


        <!--  Checked pressed  -->
        <Style Selector="^:checked:pressed /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
        </Style>

        <Style Selector="^:checked:pressed /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!--  Checked disabled  -->
        <Style Selector="^:checked:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource LauncherX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:checked:disabled /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource LauncherX.Transparent.Reverse.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherX.Transparent.Reverse.Primary}" />
        </Style>

        <Style Selector="^:checked:disabled /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource LauncherX.Foreground.Tertiary}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!--  Indeterminate normal  -->
        <Style Selector="^:indeterminate /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminate}" />
        </Style>

        <Style Selector="^:indeterminate /template/ Border#NormalRectangle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>

        <Style Selector="^:indeterminate /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminate}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Symbol" Value="{DynamicResource CheckBoxIndeterminateGlyph}" />
        </Style>


        <!--  Indeterminate pointerover  -->
        <Style Selector="^:indeterminate:pointerover /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground"
                    Value="{DynamicResource CheckBoxForegroundIndeterminatePointerOver}" />
        </Style>

        <Style Selector="^:indeterminate:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
        </Style>

        <Style Selector="^:indeterminate:pointerover /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <!--<Setter Property="Glyph" Value="{StaticResource CheckBoxIndeterminateGlyph}" />-->
        </Style>

        <!--  Indeterminate pressed  -->
        <Style Selector="^:indeterminate:pressed /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminatePressed}" />
        </Style>

        <Style Selector="^:indeterminate:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
        </Style>

        <Style Selector="^:indeterminate:pressed /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePressed}" />
            <Setter Property="Opacity" Value="1" />
            <!--<Setter Property="Glyph" Value="{StaticResource CheckBoxIndeterminateGlyph}" />-->
        </Style>


        <!--  Indeterminate disabled  -->
        <Style Selector="^:indeterminate:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminateDisabled}" />
        </Style>

        <Style Selector="^:indeterminate:disabled /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateDisabled}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminateDisabled}" />
        </Style>

        <Style Selector="^:indeterminate:disabled /template/ iconPacks|IconPack#CheckGlyph">
            <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminateDisabled}" />
            <Setter Property="Opacity" Value="1" />
            <!--<Setter Property="Glyph" Value="{StaticResource CheckBoxIndeterminateGlyph}" />-->
        </Style>

    </ControlTheme>

</ResourceDictionary>