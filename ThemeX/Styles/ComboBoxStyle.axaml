<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThemeX.Controls"
    xmlns:helpers="clr-namespace:ThemeX.Helpers"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks"
    xmlns:scroll="clr-namespace:ThemeX.Controls.Scroll"
    xmlns:themeX="clr-namespace:ThemeX">

    <x:Double x:Key="ComboBoxArrowThemeFontSize">12</x:Double>
    <x:Double x:Key="ComboBoxThemeMinWidth">64</x:Double>
    <x:Double x:Key="ComboBoxItemPillHeight">16</x:Double>
    <x:Double x:Key="ComboBoxItemPillWidth">3</x:Double>
    <x:Double x:Key="ComboBoxMinHeight">32</x:Double>

    <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
    <Thickness x:Key="ComboBoxItemThemePadding">12,4,12,4</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>
    <Thickness x:Key="ComboBoxTopHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="ComboBoxPadding">12,4,8,4</Thickness>

    <FontWeight x:Key="ComboBoxHeaderThemeFontWeight">Normal</FontWeight>

    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Padding" Value="{DynamicResource ComboBoxPadding}" />
        <Setter Property="MaxDropDownHeight" Value="504" />
        <Setter Property="MinHeight" Value="{DynamicResource ComboBoxMinHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Elevation.ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ComboBoxBorderThemeThickness}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource ThemeX.Placeholder}" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Grid ColumnDefinitions="*,32" RowDefinitions="Auto,*,Auto">
                        <ContentPresenter
                            x:Name="HeaderContentPresenter"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="{DynamicResource ComboBoxTopHeaderMargin}"
                            VerticalAlignment="Top"
                            IsVisible="False"
                            TextElement.FontWeight="{DynamicResource ComboBoxHeaderThemeFontWeight}" />

                        <Border
                            x:Name="Background"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            MinWidth="{DynamicResource ComboBoxThemeMinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <TextBlock
                            x:Name="PlaceholderTextBlock"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding PlaceholderForeground}"
                            IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}"
                            Text="{TemplateBinding PlaceholderText}"
                            TextTrimming="CharacterEllipsis" />

                        <ContentControl
                            x:Name="ContentPresenter"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding ItemTemplate}" />

                        <iconPacks:IconPack
                            Name="DropDownGlyph"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource ComboBoxArrowThemeFontSize}"
                            Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                            IsHitTestVisible="False"
                            RenderTransform="rotate(0deg)"
                            RenderTransformOrigin="50%,50%"
                            Symbol="&#xE70D;">
                            <iconPacks:IconPack.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition
                                        Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                        Property="RenderTransform"
                                        Duration="0:0:0.167" />
                                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                                </Transitions>
                            </iconPacks:IconPack.Transitions>
                        </iconPacks:IconPack>

                        <Popup
                            Name="PART_Popup"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            HorizontalOffset="-12"
                            helpers:PopupFadeAnimationHelper.IsEnabled="True"
                            helpers:PopupOverlayHelper.PreferOverlayForBackdrop="True"
                            InheritsTransform="True"
                            IsLightDismissEnabled="True"
                            IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                            PlacementTarget="Background"
                            VerticalOffset="0"
                            WindowManagerAddShadowHint="False">
                            <controls:AcrylicSurface
                                x:Name="PopupBorder"
                                MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="12,4,12,16"
                                Padding="{DynamicResource ComboBoxDropdownBorderPadding}"
                                HorizontalAlignment="Stretch"
                                CornerRadius="{DynamicResource OverlayCornerRadius}"
                                Opacity="0"
                                ShowElevationShadow="True"
                                UseVolatileCache="True"
                                Variant="Flyout">
                                <controls:AcrylicSurface.Transitions>
                                    <Transitions>
                                        <DoubleTransition
                                            Easing="QuadraticEaseOut"
                                            Property="Opacity"
                                            Duration="{x:Static helpers:PopupFadeAnimationHelper.FadeDuration}" />
                                    </Transitions>
                                </controls:AcrylicSurface.Transitions>
                                <scroll:SmoothScrollViewer
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    UseSmoothScrolling="{DynamicResource {x:Static themeX:ThemeSettings.FluentScrollKey}}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </scroll:SmoothScrollViewer>
                            </controls:AcrylicSurface>
                        </Popup>
                    </Grid>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:dropdownopen /template/ iconPacks|IconPack#DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>

        <!--  PointerOver  -->
        <Style Selector="^:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Elevation.ControlBorderHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ iconPacks|IconPack#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>

        <!--  Pressed  -->
        <Style Selector="^:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Secondary}" />
        </Style>

        <!--  Focused  -->
        <Style Selector="^:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>

        <!--  Disabled  -->
        <Style Selector="^:disabled /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlDisabled}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#PlaceholderTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ iconPacks|IconPack#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>

        <!--  Error  -->
        <Style Selector="^:error /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Foreground.Error}" />
        </Style>
    </ControlTheme>

    <!--  Fluent 2 ComboBoxItem with left accent selection pill  -->
    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemThemePadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="LayoutRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    TemplatedControl.IsTemplateFocusTarget="True">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.1" />
                        </Transitions>
                    </Border.Transitions>
                    <Panel>
                        <Border
                            Name="Pill"
                            Width="{StaticResource ComboBoxItemPillWidth}"
                            Height="{StaticResource ComboBoxItemPillHeight}"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}"
                            CornerRadius="2"
                            Opacity="0"
                            RenderTransform="scaleY(0.5)"
                            RenderTransformOrigin="50%,50%">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                    <TransformOperationsTransition
                                        Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                        Property="RenderTransform"
                                        Duration="0:0:0.167" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <ContentPresenter
                            Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!--  PointerOver  -->
        <Style Selector="^:pointerover /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtleHover}" />
        </Style>

        <!--  Pressed  -->
        <Style Selector="^:pressed /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtlePressed}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource ThemeX.Foreground.Secondary}" />
        </Style>

        <!--  Selected  -->
        <Style Selector="^:selected /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtleHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Pill">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scaleY(1)" />
        </Style>

        <Style Selector="^:selected:pointerover /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlHover}" />
        </Style>

        <Style Selector="^:selected:pressed /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtlePressed}" />
        </Style>
        <Style Selector="^:selected:pressed /template/ Border#Pill">
            <Setter Property="RenderTransform" Value="scaleY(0.625)" />
        </Style>

        <!--  Disabled  -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
