<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThemeX.Controls"
    xmlns:helpers="clr-namespace:ThemeX.Helpers">

    <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">
        <ControlTheme.Resources>
            <Thickness x:Key="AutoSuggestListMargin">4</Thickness>
            <x:Double x:Key="AutoSuggestListMaxHeight">384</x:Double>
        </ControlTheme.Resources>

        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Elevation.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
        <Setter Property="MaxDropDownHeight" Value="{StaticResource AutoSuggestListMaxHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_LayoutRoot">
                    <TextBox
                        Name="PART_TextBox"
                        Width="{TemplateBinding Width}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Margin="0"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        PlaceholderText="{TemplateBinding PlaceholderText}"
                        UseFloatingPlaceholder="{TemplateBinding UseFloatingPlaceholder}" />

                    <Popup
                        Name="PART_Popup"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        HorizontalOffset="-12"
                        helpers:PopupFadeAnimationHelper.IsEnabled="True"
                        helpers:PopupOverlayHelper.PreferOverlayForBackdrop="True"
                        IsLightDismissEnabled="True"
                        PlacementTarget="{TemplateBinding}"
                        VerticalOffset="0"
                        WindowManagerAddShadowHint="False">
                        <controls:AcrylicSurface
                            Name="PART_SuggestionsContainer"
                            MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                            Margin="12,4,12,16"
                            Padding="{StaticResource AutoSuggestListMargin}"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            Opacity="0"
                            ShowElevationShadow="True"
                            UseVolatileCache="True"
                            Variant="Flyout">
                            <controls:AcrylicSurface.Transitions>
                                <Transitions>
                                    <DoubleTransition
                                        Easing="QuadraticEaseOut"
                                        Property="Opacity"
                                        Duration="{x:Static helpers:PopupFadeAnimationHelper.FadeDuration}" />
                                </Transitions>
                            </controls:AcrylicSurface.Transitions>
                            <ListBox
                                Name="PART_SelectingItemsControl"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemTemplate="{TemplateBinding ItemTemplate}" />
                        </controls:AcrylicSurface>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
