<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThemeX.Controls"
    xmlns:helpers="clr-namespace:ThemeX.Helpers"
    xmlns:themeX="clr-namespace:ThemeX">
    <Design.PreviewWith>
        <Border Padding="20">
            <controls:MultiProgressBar />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:MultiProgressBar}" TargetType="controls:MultiProgressBar">
        <Setter Property="FillColor" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        <Setter Property="Background" Value="{DynamicResource ThemeX.ButtonBackground.Primary}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <StackPanel Spacing="8">
                        <Border
                            Height="6"
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            helpers:RoundedClipHelper.ClipToCornerRadius="True">
                            <Grid x:Name="MainGrid" ColumnSpacing="2" />
                        </Border>
                        <ItemsControl
                            x:Name="Indicators"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource ThemeX.Foreground.Secondary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="12" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controls:Indicator}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Rectangle
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Color}"
                                            RadiusX="2"
                                            RadiusY="2" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource {x:Static themeX:ThemeSettings.FontSizeCaptionKey}}"
                                            Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                                            Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
