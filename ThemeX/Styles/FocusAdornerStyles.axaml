<Style
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Selector=":is(Control)">

    <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
            <Rectangle
                Margin="1"
                Stroke="Black"
                StrokeDashArray="1,2"
                StrokeThickness="1" />
        </FocusAdornerTemplate>
    </Setter>

</Style>