<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="clr-namespace:ThemeX.Controls.Animations"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks"
    xmlns:themeX="clr-namespace:ThemeX">

    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <animations:ActivatableToggle
                    Activated="{TemplateBinding IsSelected}"
                    ActiveBrush="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorSubtleKey}}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MouseOnBrush="{DynamicResource ThemeX.Surface.SubtleHover}">
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        TextBlock.Foreground="{TemplateBinding Foreground}" />
                </animations:ActivatableToggle>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ListViewItemNotFocusableStyle"
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
    </ControlTheme>

    <ControlTheme x:Key="ListViewItemShadowStyle" TargetType="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Margin="8">
                    <Border
                        x:Name="ShadowBorder"
                        Background="{DynamicResource ThemeX.Surface.Card}"
                        BorderBrush="{DynamicResource ThemeX.Stroke.Card}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource ThemeX.Shadow.Card}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                <BoxShadowsTransition
                                    Easing="{StaticResource ThemeX.Easing.FluentStandard}"
                                    Property="BoxShadow"
                                    Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ShadowBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.BorderBrush.MouseOver}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ThemeX.Shadow.Flyout}" />
        </Style>

        <Style Selector="^:selected /template/ Border#ShadowBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ThemeX.Shadow.Flyout}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ListViewItemShadowPinStyle"
        BasedOn="{StaticResource ListViewItemShadowStyle}"
        TargetType="ListBoxItem" />

    <ControlTheme x:Key="ListViewItemServerListPinStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Margin="0,4">
                    <Border
                        x:Name="ShadowBorder"
                        HorizontalAlignment="Stretch"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <iconPacks:IconPack
                                x:Name="PinIcon"
                                Width="16"
                                Height="16"
                                Margin="0,0,12,12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="14"
                                Foreground="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorTextKey}}"
                                Symbol="&#xE718;" />
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ iconPacks|IconPack#PinIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:selected /template/ iconPacks|IconPack#PinIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ListViewItemShadowSmallMarginStyle"
        BasedOn="{StaticResource ListViewItemShadowStyle}"
        TargetType="ListBoxItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Margin="4">
                    <Border
                        x:Name="ShadowBorder"
                        Background="{DynamicResource ThemeX.Surface.Card}"
                        BorderBrush="{DynamicResource ThemeX.Stroke.Card}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource ThemeX.Shadow.Card}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                <BoxShadowsTransition
                                    Easing="{StaticResource ThemeX.Easing.FluentStandard}"
                                    Property="BoxShadow"
                                    Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ListViewItemNoEffectStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ListViewItemNoEffectFocusableStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
