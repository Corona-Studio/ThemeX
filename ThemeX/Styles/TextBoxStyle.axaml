<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ThemeX.Helpers"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks"
    xmlns:themeX="clr-namespace:ThemeX">

    <Thickness x:Key="TextBoxTopHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TextBoxInnerButtonMargin">0,0,4,0</Thickness>
    <x:Double x:Key="TextBoxIconFontSize">12</x:Double>

    <ControlTheme x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="ButtonLayoutGrid"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.1" />
                        </Transitions>
                    </Border.Transitions>
                    <iconPacks:IconPack
                        Name="Glyph"
                        Padding="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource TextBoxIconFontSize}"
                        Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                        Symbol="&#xE106;" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtleHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ iconPacks|IconPack#Glyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtlePressed}" />
        </Style>
        <Style Selector="^:pressed /template/ iconPacks|IconPack#Glyph">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorTextKey}}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#ButtonLayoutGrid">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TextBoxPasswordButtonStyle" TargetType="ToggleButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="ButtonLayoutGrid"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.1" />
                        </Transitions>
                    </Border.Transitions>
                    <iconPacks:IconPack
                        Name="Glyph"
                        Padding="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource TextBoxIconFontSize}"
                        Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                        Symbol="&#xE18B;" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtleHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ iconPacks|IconPack#Glyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtlePressed}" />
        </Style>

        <Style Selector="^:checked /template/ iconPacks|IconPack#Glyph">
            <Setter Property="Symbol" Value="&#xED1A;" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}" />
        </Style>
        <Style Selector="^:checked /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
        </Style>

        <Style Selector="^:checked:pressed /template/ Border#ButtonLayoutGrid">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#ButtonLayoutGrid">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>

    <!--  Fluent 2 TextBox with clean resting stroke and flush bottom accent focus indicator  -->
    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.Control}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Elevation.ControlBorder}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorTransparentKey}}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource TextControlThemeMinWidth}" />
        <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Panel>
                        <Border
                            Name="PART_BorderElement"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <!--  Flush Fluent 2 bottom indicator clipped cleanly to outer CornerRadius (no double-stroke stack)  -->
                        <Border
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            helpers:RoundedClipHelper.ClipToCornerRadius="True"
                            IsHitTestVisible="False">
                            <Border
                                Name="PART_FocusIndicator"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ThemeX.Stroke.ControlStrong}"
                                IsHitTestVisible="False"
                                Opacity="0.45">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition
                                            Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                            Property="Height"
                                            Duration="0:0:0.14" />
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                                        <BrushTransition Property="Background" Duration="0:0:0.14" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Border>

                        <Border Margin="{TemplateBinding BorderThickness}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentPresenter
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding InnerLeftContent}" />
                                <DockPanel
                                    x:Name="PART_InnerDockPanel"
                                    Grid.Column="1"
                                    Margin="{TemplateBinding Padding}"
                                    Cursor="IBeam">
                                    <TextBlock
                                        Name="PART_FloatingWatermark"
                                        Margin="0,0,0,4"
                                        DockPanel.Dock="Top"
                                        FontSize="{DynamicResource {x:Static themeX:ThemeSettings.FontSizeCaptionKey}}"
                                        Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                                        IsVisible="False"
                                        Text="{TemplateBinding PlaceholderText}" />
                                    <ScrollViewer
                                        AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                                        <Panel>
                                            <TextBlock
                                                Name="PART_Watermark"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Foreground="{DynamicResource ThemeX.Placeholder}"
                                                IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                Text="{TemplateBinding PlaceholderText}"
                                                TextAlignment="{TemplateBinding TextAlignment}"
                                                TextWrapping="{TemplateBinding TextWrapping}" />
                                            <TextPresenter
                                                Name="PART_TextPresenter"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                CaretBrush="{TemplateBinding CaretBrush}"
                                                CaretIndex="{TemplateBinding CaretIndex}"
                                                LineHeight="{TemplateBinding LineHeight}"
                                                PasswordChar="{TemplateBinding PasswordChar}"
                                                RevealPassword="{TemplateBinding RevealPassword}"
                                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                SelectionStart="{TemplateBinding SelectionStart}"
                                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                                TextAlignment="{TemplateBinding TextAlignment}"
                                                TextWrapping="{TemplateBinding TextWrapping}" />
                                        </Panel>
                                    </ScrollViewer>
                                </DockPanel>
                                <ContentPresenter
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding InnerRightContent}" />
                            </Grid>
                        </Border>
                    </Panel>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <!--  Multi-line inputs align text to top cleanly  -->
        <Style Selector="^[AcceptsReturn=True]">
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!--  Disabled State  -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />

            <Style Selector="^ /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Control}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_FocusIndicator">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <Style Selector="^ /template/ TextBlock#PART_Watermark, ^ /template/ TextBlock#PART_FloatingWatermark">
                <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            </Style>
        </Style>

        <!--  PointerOver State  -->
        <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Elevation.ControlBorderHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_FocusIndicator">
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <!--  Focused State  -->
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlInputActive}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusIndicator">
            <Setter Property="Height" Value="2" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        </Style>
        <Style Selector="^:focus /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorTextKey}}" />
        </Style>

        <!--  Error State  -->
        <Style Selector="^:error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Foreground.Error}" />
        </Style>
        <Style Selector="^:error /template/ Border#PART_FocusIndicator">
            <Setter Property="Height" Value="2" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ThemeX.Foreground.Error}" />
        </Style>

        <Style Selector="^[UseFloatingPlaceholder=true]:not(:empty) /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^.revealPasswordButton[AcceptsReturn=False][IsReadOnly=False]:not(TextBox:empty)">
            <Setter Property="InnerRightContent">
                <Template>
                    <ToggleButton
                        Width="24"
                        Height="24"
                        Margin="{DynamicResource TextBoxInnerButtonMargin}"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        CornerRadius="4"
                        Focusable="False"
                        FontSize="{TemplateBinding FontSize}"
                        IsChecked="{Binding $parent[TextBox].RevealPassword, Mode=TwoWay}"
                        IsTabStop="False"
                        Theme="{StaticResource TextBoxPasswordButtonStyle}" />
                </Template>
            </Setter>
        </Style>

        <Style Selector="^.clearButton[AcceptsReturn=False][IsReadOnly=False]:focus:not(TextBox:empty)">
            <Setter Property="InnerRightContent">
                <Template>
                    <Button
                        Width="24"
                        Height="24"
                        Margin="{DynamicResource TextBoxInnerButtonMargin}"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding $parent[TextBox].Clear}"
                        CornerRadius="4"
                        Focusable="False"
                        FontSize="{TemplateBinding FontSize}"
                        IsTabStop="False"
                        Theme="{StaticResource TextBoxDeleteButtonStyle}" />
                </Template>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
