<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="clr-namespace:ThemeX.Controls.Animations;assembly=ThemeX"
    xmlns:cc="clr-namespace:ThemeX.Controls.Effects;assembly=ThemeX"
    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
    xmlns:themeX="clr-namespace:ThemeX;assembly=ThemeX">

    <ControlTheme x:Key="{x:Type animations:AnimationLayer}" TargetType="animations:AnimationLayer">
        <ControlTheme.Resources>
            <converters:CornerRadiusToDoubleConverter x:Key="TopLeftCornerConverter" Corner="TopLeft" />
        </ControlTheme.Resources>

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel
                    x:Name="Panel"
                    Background="{TemplateBinding Background}"
                    ClipToBounds="True">
                    <Rectangle
                        Name="ActiveRect"
                        ClipToBounds="True"
                        Fill="{TemplateBinding MouseOnBrush}"
                        IsHitTestVisible="False"
                        Opacity="0"
                        RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerConverter}}"
                        RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerConverter}}">
                        <Rectangle.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                    Property="Opacity"
                                    Duration="0:0:0.167" />
                            </Transitions>
                        </Rectangle.Transitions>
                    </Rectangle>
                    <!--  Keep ripple/halo canvas transparent so it never occludes ActiveRect  -->
                    <Canvas
                        Name="PART_RippleCanvasRoot"
                        Background="Transparent"
                        IsHitTestVisible="False" />
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
