<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ThemeX.Helpers"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks">

    <x:Double x:Key="ExpanderMinHeight">48</x:Double>
    <Thickness x:Key="ExpanderHeaderPadding">16,8,12,8</Thickness>
    <Thickness x:Key="ExpanderChevronMargin">0,4,8,4</Thickness>
    <x:String x:Key="ExpanderChevronUpGlyph">&#xE70E;</x:String>
    <x:String x:Key="ExpanderChevronDownGlyph">&#xE70D;</x:String>
    <x:String x:Key="ExpanderChevronLeftGlyph">&#xE76B;</x:String>
    <x:String x:Key="ExpanderChevronRightGlyph">&#xE76C;</x:String>

    <x:Double x:Key="ExpanderChevronButtonSize">32</x:Double>
    <Thickness x:Key="ExpanderHeaderBorderThickness">1</Thickness>
    <Thickness x:Key="ExpanderContentPadding">16</Thickness>
    <Thickness x:Key="ExpanderContentDownBorderThickness">1,0,1,1</Thickness>
    <Thickness x:Key="ExpanderContentUpBorderThickness">1,1,1,0</Thickness>
    <Thickness x:Key="ExpanderContentRightBorderThickness">0,1,1,1</Thickness>
    <Thickness x:Key="ExpanderContentLeftBorderThickness">1,1,0,1</Thickness>

    <!--  Fluent 2 Expander Header ToggleButton  -->
    <ControlTheme x:Key="ExpanderToggleButton" TargetType="ToggleButton">
        <Setter Property="ZIndex" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Card}" />
        <Setter Property="BorderThickness" Value="{StaticResource ExpanderHeaderBorderThickness}" />
        <Setter Property="Padding" Value="{StaticResource ExpanderHeaderPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Name="Root"
                        Width="{TemplateBinding Width}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        MaxWidth="{TemplateBinding MaxWidth}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>

                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter
                                Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />

                            <Border
                                Name="ExpandCollapseChevronBorder"
                                Grid.Column="1"
                                Width="{StaticResource ExpanderChevronButtonSize}"
                                Height="{StaticResource ExpanderChevronButtonSize}"
                                Margin="{StaticResource ExpanderChevronMargin}"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.12" />
                                    </Transitions>
                                </Border.Transitions>

                                <iconPacks:IconPack
                                    x:Name="ExpandCollapseChevron"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                                    RenderTransform="rotate(0deg)"
                                    RenderTransformOrigin="50%,50%"
                                    Symbol="{TemplateBinding Tag}">
                                    <iconPacks:IconPack.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition
                                                Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                                Property="RenderTransform"
                                                Duration="0:0:0.167" />
                                        </Transitions>
                                    </iconPacks:IconPack.Transitions>
                                </iconPacks:IconPack>
                            </Border>
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.BorderBrush.MouseOver}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtleHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ iconPacks|IconPack#ExpandCollapseChevron">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtlePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ iconPacks|IconPack#ExpandCollapseChevron">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>

        <Style Selector="^:checked /template/ iconPacks|IconPack#ExpandCollapseChevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>
    </ControlTheme>

    <ControlTemplate x:Key="ExpanderExpandLeftTemplate" TargetType="{x:Type Expander}">
        <Grid ColumnDefinitions="*,Auto">
            <ToggleButton
                Name="PART_toggle"
                Grid.Column="1"
                MinHeight="{TemplateBinding MinHeight}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                IsEnabled="{TemplateBinding IsEnabled}"
                Tag="{StaticResource ExpanderChevronLeftGlyph}"
                Theme="{StaticResource ExpanderToggleButton}" />

            <Border
                Name="ExpanderContent"
                Grid.Column="0"
                MinWidth="{TemplateBinding MinWidth}"
                MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                ClipToBounds="True"
                helpers:RoundedClipHelper.ClipToCornerRadius="True"
                CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource LeftCornerRadiusFilterConverter}}"
                IsVisible="False">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    IsVisible="{TemplateBinding IsExpanded}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ExpanderExpandRightTemplate" TargetType="{x:Type Expander}">
        <Grid ColumnDefinitions="Auto,*">
            <ToggleButton
                Name="PART_toggle"
                Grid.Column="0"
                MinHeight="{TemplateBinding MinHeight}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                IsEnabled="{TemplateBinding IsEnabled}"
                Tag="{StaticResource ExpanderChevronRightGlyph}"
                Theme="{StaticResource ExpanderToggleButton}" />

            <Border
                Name="ExpanderContent"
                Grid.Column="1"
                MinWidth="{TemplateBinding MinWidth}"
                MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                ClipToBounds="True"
                helpers:RoundedClipHelper.ClipToCornerRadius="True"
                CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource RightCornerRadiusFilterConverter}}"
                IsVisible="False">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    IsVisible="{TemplateBinding IsExpanded}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ExpanderExpandUpTemplate" TargetType="{x:Type Expander}">
        <Grid RowDefinitions="*,Auto">
            <ToggleButton
                Name="PART_toggle"
                Grid.Row="1"
                MinHeight="{TemplateBinding MinHeight}"
                HorizontalAlignment="Stretch"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                IsEnabled="{TemplateBinding IsEnabled}"
                Tag="{StaticResource ExpanderChevronUpGlyph}"
                Theme="{StaticResource ExpanderToggleButton}" />

            <Border
                Name="ExpanderContent"
                Grid.Row="0"
                MinWidth="{TemplateBinding MinWidth}"
                MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                ClipToBounds="True"
                helpers:RoundedClipHelper.ClipToCornerRadius="True"
                CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource TopCornerRadiusFilterConverter}}"
                IsVisible="False">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    IsVisible="{TemplateBinding IsExpanded}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ExpanderExpandDownTemplate" TargetType="{x:Type Expander}">
        <Grid RowDefinitions="Auto,*">
            <ToggleButton
                Name="PART_toggle"
                Grid.Row="0"
                MinHeight="{TemplateBinding MinHeight}"
                HorizontalAlignment="Stretch"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                IsEnabled="{TemplateBinding IsEnabled}"
                Tag="{StaticResource ExpanderChevronDownGlyph}"
                Theme="{StaticResource ExpanderToggleButton}" />

            <Border
                Name="ExpanderContent"
                Grid.Row="1"
                MinWidth="{TemplateBinding MinWidth}"
                MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                ClipToBounds="True"
                helpers:RoundedClipHelper.ClipToCornerRadius="True"
                CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource BottomCornerRadiusFilterConverter}}"
                IsVisible="False">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    IsVisible="{TemplateBinding IsExpanded}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.CardSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource FlyoutThemeMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ExpanderMinHeight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.Card}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource ExpanderContentPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="ContentTransition">
            <Setter.Value>
                <CompositePageTransition>
                    <CrossFade Duration="00:00:00.2" />
                    <PageSlide Orientation="Vertical" Duration="00:00:00.22">
                        <PageSlide.SlideInEasing>
                            <SplineEasing X1="0.1" Y1="0.9" X2="0.2" Y2="1" />
                        </PageSlide.SlideInEasing>
                        <PageSlide.SlideOutEasing>
                            <SplineEasing X1="0.1" Y1="0.9" X2="0.2" Y2="1" />
                        </PageSlide.SlideOutEasing>
                    </PageSlide>
                </CompositePageTransition>
            </Setter.Value>
        </Setter>

        <Style Selector="^:down">
            <Setter Property="BorderThickness" Value="{StaticResource ExpanderContentDownBorderThickness}" />
            <Setter Property="Template" Value="{StaticResource ExpanderExpandDownTemplate}" />

            <Style Selector="^:expanded /template/ ToggleButton#PART_toggle">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource TopCornerRadiusFilterConverter}}" />
            </Style>
        </Style>

        <Style Selector="^:up">
            <Setter Property="BorderThickness" Value="{StaticResource ExpanderContentUpBorderThickness}" />
            <Setter Property="Template" Value="{StaticResource ExpanderExpandUpTemplate}" />

            <Style Selector="^:expanded /template/ ToggleButton#PART_toggle">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
            </Style>
        </Style>

        <Style Selector="^:left">
            <Setter Property="BorderThickness" Value="{StaticResource ExpanderContentLeftBorderThickness}" />
            <Setter Property="Template" Value="{StaticResource ExpanderExpandLeftTemplate}" />

            <Style Selector="^:expanded /template/ ToggleButton#PART_toggle">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource RightCornerRadiusFilterConverter}}" />
            </Style>
        </Style>

        <Style Selector="^:right">
            <Setter Property="BorderThickness" Value="{StaticResource ExpanderContentRightBorderThickness}" />
            <Setter Property="Template" Value="{StaticResource ExpanderExpandRightTemplate}" />

            <Style Selector="^:expanded /template/ ToggleButton#PART_toggle">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource LeftCornerRadiusFilterConverter}}" />
            </Style>
        </Style>

        <Style Selector="^:expanded /template/ Border#ExpanderContent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
