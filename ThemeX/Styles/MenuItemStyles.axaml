<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThemeX.Controls"
    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
    xmlns:helpers="clr-namespace:ThemeX.Helpers"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:themeX="clr-namespace:ThemeX">

    <Thickness x:Key="MenuBarItemMargin">4,4</Thickness>
    <x:Double x:Key="MenuFlyoutSeparatorHeight">1</x:Double>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
    <x:Double x:Key="MenuFlyoutThemeMinHeight">32</x:Double>
    <Thickness x:Key="MenuFlyoutItemChevronMargin">20,0,0,0</Thickness>
    <Thickness x:Key="MenuFlyoutSeparatorThemePadding">8,4</Thickness>
    <Thickness x:Key="MenuFlyoutItemMargin">0,2</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePadding">12,4,12,4</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">12,4,12,4</Thickness>
    <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
    <Thickness x:Key="MenuInputGestureTextMargin">24,0,0,0</Thickness>
    <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">-12</x:Double>
    <converters:PlatformKeyGestureConverter x:Key="KeyGestureConverter" />

    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="helpers:SubmenuAnimationHelper.IsEnabled" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource MenuFlyoutItemThemePaddingNarrow}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Panel Margin="{StaticResource MenuFlyoutItemMargin}">
                        <Border
                            Name="PART_LayoutRoot"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGT" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemChevron" />
                                </Grid.ColumnDefinitions>

                                <Viewbox
                                    Name="PART_IconPresenter"
                                    Width="16"
                                    Height="16"
                                    Margin="{DynamicResource MenuIconPresenterMargin}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="False"
                                    StretchDirection="DownOnly">
                                    <ContentPresenter
                                        Name="PART_IconContentPresenter"
                                        Content="{TemplateBinding Icon}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Viewbox>

                                <ContentPresenter
                                    Name="PART_HeaderPresenter"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.DataTemplates>
                                        <DataTemplate DataType="system:String">
                                            <AccessText Text="{Binding}" />
                                        </DataTemplate>
                                    </ContentPresenter.DataTemplates>
                                </ContentPresenter>

                                <TextBlock
                                    x:Name="PART_InputGestureText"
                                    Grid.Column="2"
                                    Margin="{DynamicResource MenuInputGestureTextMargin}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource {x:Static themeX:ThemeSettings.FontSizeCaptionKey}}"
                                    Foreground="{DynamicResource ThemeX.Foreground.Tertiary}"
                                    Text="{TemplateBinding InputGesture, Converter={StaticResource KeyGestureConverter}}" />

                                <iconPacks:IconPack
                                    Name="PART_ChevronPath"
                                    Grid.Column="3"
                                    Width="12"
                                    Height="12"
                                    Margin="{DynamicResource MenuFlyoutItemChevronMargin}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource ThemeX.Foreground.Secondary}"
                                    Symbol="&#xE76C;" />
                            </Grid>
                        </Border>
                    </Panel>

                    <Popup
                        Name="PART_Popup"
                        HorizontalOffset="{DynamicResource MenuFlyoutSubItemPopupHorizontalOffset}"
                        VerticalOffset="-12"
                        helpers:PopupOverlayHelper.PreferOverlayForBackdrop="True"
                        IsLightDismissEnabled="False"
                        IsOpen="{TemplateBinding (helpers:SubmenuAnimationHelper.IsPopupOpen)}"
                        Placement="RightEdgeAlignedTop"
                        WindowManagerAddShadowHint="False">
                        <controls:AcrylicSurface
                            Name="PART_SubmenuPresenter"
                            MinHeight="{DynamicResource MenuFlyoutThemeMinHeight}"
                            MaxWidth="{DynamicResource FlyoutThemeMaxWidth}"
                            Margin="12,8,12,20"
                            Padding="{DynamicResource MenuFlyoutPresenterThemePadding}"
                            HorizontalAlignment="Stretch"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            IsHitTestVisible="{TemplateBinding IsSubMenuOpen}"
                            Opacity="{TemplateBinding (helpers:SubmenuAnimationHelper.Opacity)}"
                            ShowElevationShadow="True"
                            UseVolatileCache="True"
                            Variant="Flyout">
                            <controls:AcrylicSurface.Transitions>
                                <Transitions>
                                    <DoubleTransition
                                        Easing="QuadraticEaseOut"
                                        Property="Opacity"
                                        Duration="{x:Static helpers:SubmenuAnimationHelper.FadeDuration}" />
                                </Transitions>
                            </controls:AcrylicSurface.Transitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter
                                    Name="PART_ItemsPresenter"
                                    Grid.IsSharedSizeScope="True"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </controls:AcrylicSurface>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:icon /template/ Viewbox#PART_IconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtleHover}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.SubtlePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            <Style Selector="^ /template/ TextBlock#PART_InputGestureText">
                <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            </Style>
            <Style Selector="^ /template/ iconPacks|IconPack#PART_ChevronPath">
                <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            </Style>
        </Style>

        <Style Selector="^:open /template/ iconPacks|IconPack#PART_ChevronPath">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>

        <Style Selector="^:empty /template/ iconPacks|IconPack#PART_ChevronPath">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:separator">
            <Setter Property="Template">
                <ControlTemplate>
                    <Separator Margin="{StaticResource MenuFlyoutSeparatorThemePadding}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
