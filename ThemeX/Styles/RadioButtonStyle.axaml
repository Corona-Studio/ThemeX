<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:themeX="clr-namespace:ThemeX">

    <Design.PreviewWith>
        <Border Padding="50">
            <StackPanel Spacing="5">
                <RadioButton Content="Radio" />
                <RadioButton Content="Radio" IsChecked="True" />
                <RadioButton Content="Radio" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <system:Double x:Key="RadioButtonBorderThemeThickness">1</system:Double>

    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">

        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.BorderBrush}" />
        <Setter Property="Padding" Value="8,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                    <Grid ColumnDefinitions="20,*">

                        <Grid
                            Grid.Column="0"
                            Height="32"
                            VerticalAlignment="Top">

                            <Ellipse
                                Name="OuterEllipse"
                                Width="20"
                                Height="20"
                                UseLayoutRounding="False" />

                            <!--  A seperate element is added since the two orthogonal state groups that cannot touch the same property  -->
                            <Ellipse
                                Name="CheckOuterEllipse"
                                Width="20"
                                Height="20"
                                UseLayoutRounding="False" />

                            <Ellipse
                                Name="CheckGlyph"
                                Width="12"
                                Height="12"
                                UseLayoutRounding="False" />

                            <!--  A seperate element is added since the two orthogonal state groups that cannot touch the same property  -->
                            <Border
                                Name="PressedCheckGlyph"
                                Width="4"
                                Height="4"
                                CornerRadius="6"
                                UseLayoutRounding="False" />
                        </Grid>

                        <ContentPresenter
                            Name="ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.BorderBrush}" />
            <Setter Property="StrokeThickness" Value="{DynamicResource RadioButtonBorderThemeThickness}" />

        </Style>
        <Style Selector="^ /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Stroke"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="Fill"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="StrokeThickness" Value="{DynamicResource RadioButtonBorderThemeThickness}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ Ellipse#CheckGlyph">
            <Setter Property="Stroke"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}" />
            <Setter Property="Fill"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scaleX(0.86) scaleY(0.86)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition
                        Easing="0.0,0.0 0.0,1.0"
                        Property="RenderTransform"
                        Duration="0:0:0.167" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PressedCheckGlyph">
            <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonCheckGlyphStroke}" />
            <Setter Property="Background" Value="{DynamicResource RadioButtonCheckGlyphFill}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scaleX(0.86) scaleY(0.86)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition
                        Easing="0,0 0,1"
                        Property="RenderTransform"
                        Duration="0:0:0.167" />
                </Transitions>
            </Setter>
        </Style>

        <!--  PointerOver  -->
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource RadioButtonBackgroundPointerOver}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RadioButtonBorderBrushPointerOver}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.BorderBrush.MouseOver}" />
            <Setter Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillPointerOver}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Stroke"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
            <Setter Property="Fill"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#CheckGlyph">
            <Setter Property="Stroke"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}" />
            <Setter Property="Fill"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scaleX(1.167) scaleY(1.167)" />
        </Style>

        <!--  Pressed  -->
        <Style Selector="^:pressed /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.ButtonBackground.Pressed}" />
        </Style>
        <Style Selector="^:pressed /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Stroke"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
            <Setter Property="Fill"
                    Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorLight1Key}}" />
        </Style>
        <Style Selector="^:pressed /template/ Ellipse#CheckGlyph">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scaleX(0.71) scaleY(0.71)" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PressedCheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scaleX(2.5) scaleY(2.5)" />
        </Style>

        <!--  Disabled  -->
        <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.BorderBrush.MouseOver}" />
            <Setter Property="Fill" Value="{DynamicResource ThemeX.BorderBrush.MouseOver}" />
        </Style>

        <!--  Checked  -->
        <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource RadioButtonCheckGlyphStrokeChecked}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ Border#PressedCheckGlyph">
            <Setter Property="Opacity" Value="0" />
        </Style>

    </ControlTheme>

</ResourceDictionary>