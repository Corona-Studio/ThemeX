<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:themeX="clr-namespace:ThemeX">

    <system:Double x:Key="RadioButtonBorderThemeThickness">1</system:Double>

    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Stroke.ControlStrong}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="20,*">
                        <Grid
                            Grid.Column="0"
                            Height="32"
                            VerticalAlignment="Center">
                            <Ellipse
                                Name="OuterEllipse"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource ThemeX.Surface.Control}"
                                Stroke="{DynamicResource ThemeX.Stroke.ControlStrong}"
                                StrokeThickness="{StaticResource RadioButtonBorderThemeThickness}">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                        <BrushTransition Property="Fill" Duration="0:0:0.12" />
                                        <BrushTransition Property="Stroke" Duration="0:0:0.12" />
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>

                            <Ellipse
                                Name="CheckOuterEllipse"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}"
                                Opacity="0"
                                Stroke="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}"
                                StrokeThickness="{StaticResource RadioButtonBorderThemeThickness}">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                        <BrushTransition Property="Fill" Duration="0:0:0.12" />
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>

                            <Ellipse
                                Name="CheckGlyph"
                                Width="8"
                                Height="8"
                                Fill="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorForegroundKey}}"
                                Opacity="0"
                                RenderTransform="scale(0.5)"
                                RenderTransformOrigin="50%,50%">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                        <TransformOperationsTransition
                                            Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                            Property="RenderTransform"
                                            Duration="0:0:0.167" />
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Grid>

                        <ContentPresenter
                            Name="ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!--  Empty Content  -->
        <Style Selector="^ /template/ ContentPresenter#ContentPresenter:empty">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!--  PointerOver  -->
        <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Surface.ControlHover}" />
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.Foreground.Secondary}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
            <Setter Property="Stroke" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
        </Style>

        <!--  Pressed  -->
        <Style Selector="^:pressed /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Surface.ControlPressed}" />
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:pressed /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
            <Setter Property="Stroke" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
        </Style>

        <!--  Checked  -->
        <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:checked:pointerover /template/ Ellipse#CheckGlyph">
            <Setter Property="RenderTransform" Value="scale(1.2)" />
        </Style>
        <Style Selector="^:checked:pressed /template/ Ellipse#CheckGlyph">
            <Setter Property="RenderTransform" Value="scale(0.8)" />
        </Style>

        <!--  Disabled  -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Surface.ControlDisabled}" />
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Surface.ControlDisabled}" />
            <Setter Property="Stroke" Value="{DynamicResource ThemeX.Stroke.Control}" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
