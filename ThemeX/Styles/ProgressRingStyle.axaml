<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThemeX.Controls"
    xmlns:converters="clr-namespace:ThemeX.Converters"
    xmlns:themeX="clr-namespace:ThemeX">

    <ControlTheme x:Key="{x:Type controls:ProgressRing}" TargetType="controls:ProgressRing">
        <ControlTheme.Resources>
            <converters:FitSquarelyWithinAspectRatioConverter x:Key="FitSquarelyWithinAspectRatioConverter" />
        </ControlTheme.Resources>

        <Style Selector="^">
            <Setter Property="Background" Value="{DynamicResource ThemeX.ButtonBackground.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel x:Name="FluentRingRoot">
                        <Ellipse
                            x:Name="Track"
                            Stroke="{TemplateBinding Background}"
                            StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Arc
                            x:Name="Fill"
                            StartAngle="{TemplateBinding StartAngle}"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeLineCap="Round"
                            StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"
                            SweepAngle="{TemplateBinding ValueAngle}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:preserveaspect">
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="8" />
        </Style>

        <Style Selector="^:preserveaspect /template/ Panel#FluentRingRoot">
            <Setter Property="Width" Value="{TemplateBinding Bounds, Converter={StaticResource FitSquarelyWithinAspectRatioConverter}}" />
            <Setter Property="Height" Value="{TemplateBinding Bounds, Converter={StaticResource FitSquarelyWithinAspectRatioConverter}}" />
        </Style>

        <Style Selector="^[IsEnabled=True][IsVisible=True]:indeterminate /template/ Arc#Fill">
            <Style.Animations>
                <Animation
                    Easing="QuadraticEaseInOut"
                    FillMode="Both"
                    IterationCount="INFINITE"
                    Duration="0:0:2.4">
                    <KeyFrame Cue="0%">
                        <Setter Property="StartAngle" Value="-720" />
                        <Setter Property="SweepAngle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="12.5%">
                        <Setter Property="StartAngle" Value="-540" />
                        <Setter Property="SweepAngle" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="StartAngle" Value="-360" />
                        <Setter Property="SweepAngle" Value="100" />
                    </KeyFrame>
                    <KeyFrame Cue="32.5%">
                        <Setter Property="StartAngle" Value="-180" />
                        <Setter Property="SweepAngle" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="StartAngle" Value="0" />
                        <Setter Property="SweepAngle" Value="5" />
                    </KeyFrame>
                    <KeyFrame Cue="62.5%">
                        <Setter Property="StartAngle" Value="180" />
                        <Setter Property="SweepAngle" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="75%">
                        <Setter Property="StartAngle" Value="360" />
                        <Setter Property="SweepAngle" Value="100" />
                    </KeyFrame>
                    <KeyFrame Cue="87.5%">
                        <Setter Property="StartAngle" Value="540" />
                        <Setter Property="SweepAngle" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StartAngle" Value="720" />
                        <Setter Property="SweepAngle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^[IsEnabled=True][IsVisible=True]:indeterminate /template/ Ellipse#Track">
            <Style.Animations>
                <Animation IterationCount="INFINITE" Duration="0:0:1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.99" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

</ResourceDictionary>
