<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks">
    <!--  Another really complex template...  -->

    <Design.PreviewWith>
        <Border Padding="50" Background="#F3F3f3">
            <StackPanel>
                <ScrollViewer
                    MaxWidth="180"
                    MaxHeight="100"
                    HorizontalScrollBarVisibility="Auto">
                    <StackPanel Spacing="5">
                        <Rectangle
                            Width="200"
                            Height="40"
                            Fill="CadetBlue" />
                        <Rectangle
                            Width="200"
                            Height="40"
                            Fill="CadetBlue" />
                        <Rectangle
                            Width="200"
                            Height="40"
                            Fill="CadetBlue" />
                        <Rectangle
                            Width="200"
                            Height="40"
                            Fill="CadetBlue" />
                        <Rectangle
                            Width="200"
                            Height="40"
                            Fill="CadetBlue" />
                    </StackPanel>
                </ScrollViewer>
                <Panel Width="150" Height="150">
                    <ScrollBar
                        Margin="0,0,0,20"
                        HorizontalAlignment="Right"
                        AllowAutoHide="False"
                        Orientation="Vertical" />
                    <ScrollBar
                        VerticalAlignment="Bottom"
                        AllowAutoHide="False"
                        Orientation="Horizontal" />
                </Panel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>


    <!--<x:String x:Key="ScrollBarExpandDuration">00:00:00.167</x:String>
        <x:String x:Key="ScrollBarOpacityChangeDuration">00:00:00.083</x:String>
        <x:String x:Key="ScrollBarColorChangeDuration">00:00:00.083</x:String>
        <x:String x:Key="ScrollBarContractDuration">00:00:00.167</x:String>-->
    <x:Double x:Key="ScrollBarThumbOffset">2</x:Double>

    <!--<x:String x:Key="ScrollBarContractDelay">00:00:02</x:String>
        <x:String x:Key="ScrollBarContractFinalKeyframe">00:00:02.1</x:String>-->
    <x:Double x:Key="ScrollBarSize">12</x:Double>
    <Thickness x:Key="ScrollBarMargin">1</Thickness>

    <x:Double x:Key="ScrollBarVerticalThumbMinHeight">30</x:Double>
    <x:Double x:Key="ScrollBarVerticalThumbMinWidth">12</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinWidth">30</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">12</x:Double>
    <x:Double x:Key="ScrollBarThumbStrokeThickness">4</x:Double>
    <x:Double x:Key="ScrollBarButtonArrowIconFontSize">8</x:Double>

    <ControlTheme x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource LauncherX.Transparent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarThumbBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Name="ThumbVisual"
                        Fill="{DynamicResource LauncherX.Transparent.Reverse.Primary}"
                        RadiusX="4"
                        RadiusY="4"
                        Stroke="{TemplateBinding BorderBrush}"
                        StrokeThickness="{DynamicResource ScrollBarThumbStrokeThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
            </Transitions>
        </Setter>

        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPointerOver}" />
        </Style>
        <Style Selector="^:pressed  /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
        </Style>
        <Style Selector="^:disabled  /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillDisabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ScrollBarLineButton" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="Root"
                    Background="{DynamicResource ScrollBarButtonBackground}"
                    BorderBrush="{DynamicResource ScrollBarButtonBorderBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                    <iconPacks:IconPack
                        Name="ArrowGlyph"
                        Padding="0"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource ScrollBarButtonArrowIconFontSize}"
                        Foreground="{DynamicResource LauncherX.Foreground.Primary}"
                        RenderTransform="none"
                        RenderTransformOrigin="50%,50%"
                        Symbol="{TemplateBinding Content}">
                        <iconPacks:IconPack.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.016" />
                            </Transitions>
                        </iconPacks:IconPack.Transitions>
                    </iconPacks:IconPack>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.016" />
            </Transitions>
        </Setter>

        <Style Selector="^:pointerover /template/ iconPacks|IconPack">
            <Setter Property="Foreground" Value="{DynamicResource ScrollBarButtonArrowForegroundPointerOver}" />
        </Style>
        <Style Selector="^:pressed /template/ iconPacks|IconPack">
            <Setter Property="RenderTransform" Value="scale(0.875)" />
            <Setter Property="Foreground" Value="{DynamicResource ScrollBarButtonArrowForegroundPressed}" />
        </Style>
        <Style Selector="^:disabled /template/ iconPacks|IconPack">
            <Setter Property="Foreground" Value="{DynamicResource ScrollBarButtonArrowForegroundDisabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="{DynamicResource ScrollBarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource ScrollBarSize}" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ScrollBarForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarBorderBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />

        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="Root">
                        <Border
                            Name="VerticalRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid RowDefinitions="Auto,*,Auto">

                                <Rectangle
                                    Name="TrackRect"
                                    Grid.RowSpan="3"
                                    Margin="0"
                                    Fill="{DynamicResource ScrollBarTrackFill}"
                                    Opacity="0"
                                    RadiusX="6"
                                    RadiusY="6"
                                    Stroke="{DynamicResource ScrollBarTrackStroke}"
                                    StrokeThickness="{DynamicResource ScrollBarTrackBorderThemeThickness}" />

                                <RepeatButton
                                    Name="PART_LineUpButton"
                                    Grid.Row="0"
                                    Width="{DynamicResource ScrollBarSize}"
                                    Height="{DynamicResource ScrollBarSize}"
                                    Margin="1,0,0,0"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDDB;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />

                                <Track
                                    Grid.Row="1"
                                    IsDirectionReversed="True"
                                    Maximum="{TemplateBinding Maximum}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Orientation="{TemplateBinding Orientation}"
                                    ViewportSize="{TemplateBinding ViewportSize}"
                                    Value="{TemplateBinding Value,
                                                            Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton
                                            Name="PART_PageUpButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton
                                            Name="PART_PageDownButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.IncreaseButton>
                                    <Thumb
                                        MinWidth="{StaticResource ScrollBarVerticalThumbMinWidth}"
                                        MinHeight="{StaticResource ScrollBarVerticalThumbMinHeight}"
                                        Background="{DynamicResource ScrollBarPanningThumbBackground}"
                                        BorderBrush="{DynamicResource ScrollBarThumbBorderBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="1"
                                        RenderTransformOrigin="100%,100%"
                                        Theme="{StaticResource ScrollBarThumb}" />
                                </Track>

                                <RepeatButton
                                    Name="PART_LineDownButton"
                                    Grid.Row="2"
                                    Height="{DynamicResource ScrollBarSize}"
                                    MinWidth="{DynamicResource ScrollBarSize}"
                                    Margin="1,0,0,0"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDDC;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />

                            </Grid>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="RenderTransform" Value="{DynamicResource VerticalSmallScrollThumbScaleTransform}" />
            </Style>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="Root">
                        <Border
                            Name="VerticalRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Rectangle
                                    Name="TrackRect"
                                    Grid.ColumnSpan="3"
                                    Margin="0"
                                    Fill="{DynamicResource ScrollBarTrackFill}"
                                    Opacity="0"
                                    RadiusX="6"
                                    RadiusY="6"
                                    Stroke="{DynamicResource ScrollBarTrackStroke}"
                                    StrokeThickness="{DynamicResource ScrollBarTrackBorderThemeThickness}">
                                    <Rectangle.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                                        </Transitions>
                                    </Rectangle.Transitions>
                                </Rectangle>

                                <RepeatButton
                                    Name="PART_LineUpButton"
                                    Grid.Row="0"
                                    Width="{DynamicResource ScrollBarSize}"
                                    MinHeight="{DynamicResource ScrollBarSize}"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDD9;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />

                                <Track
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding Maximum}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Orientation="{TemplateBinding Orientation}"
                                    ViewportSize="{TemplateBinding ViewportSize}"
                                    Value="{TemplateBinding Value,
                                                            Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton
                                            Name="PART_PageUpButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton
                                            Name="PART_PageDownButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.IncreaseButton>
                                    <Thumb
                                        MinHeight="{DynamicResource ScrollBarHorizontalThumbMinHeight}"
                                        Margin="0,0,0,5"
                                        Background="{DynamicResource ScrollBarPanningThumbBackground}"
                                        BorderBrush="{DynamicResource ScrollBarThumbBorderBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="1"
                                        RenderTransformOrigin="100%,100%"
                                        Theme="{StaticResource ScrollBarThumb}" />
                                </Track>

                                <RepeatButton
                                    Name="PART_LineDownButton"
                                    Grid.Column="2"
                                    Height="{DynamicResource ScrollBarSize}"
                                    MinWidth="{DynamicResource ScrollBarSize}"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDDA;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />

                            </Grid>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="RenderTransform" Value="{DynamicResource HorizontalSmallScrollThumbScaleTransform}" />
            </Style>
        </Style>

        <Style Selector="^[IsExpanded=true]">
            <Style Selector="^ /template/ Grid#Root">
                <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ Rectangle#TrackRect">
                <Setter Property="Stroke" Value="{DynamicResource ScrollBarTrackStrokePointerOver}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ Thumb">
                <Setter Property="RenderTransform" Value="none" />
                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackground}" />
            </Style>
            <Style Selector="^ /template/ RepeatButton">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ Grid#Root">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

</ResourceDictionary>