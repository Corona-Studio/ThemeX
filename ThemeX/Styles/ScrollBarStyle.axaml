<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ThemeX.Helpers"
    xmlns:iconPacks="clr-namespace:ThemeX.Controls.IconPacks">

    <x:Double x:Key="ScrollBarThumbOffset">2</x:Double>
    <x:Double x:Key="ScrollBarSize">12</x:Double>

    <x:Double x:Key="ScrollBarVerticalThumbMinHeight">32</x:Double>
    <x:Double x:Key="ScrollBarVerticalThumbMinWidth">12</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinWidth">32</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">12</x:Double>
    <x:Double x:Key="ScrollBarThumbStrokeThickness">3</x:Double>
    <x:Double x:Key="ScrollBarButtonArrowIconFontSize">8</x:Double>

    <ControlTheme x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ThemeX.Stroke.ControlStrong}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Rectangle
                    Name="ThumbVisual"
                    Fill="{TemplateBinding Background}"
                    Opacity="0.48"
                    RadiusX="5"
                    RadiusY="5"
                    Stroke="{TemplateBinding BorderBrush}"
                    StrokeThickness="{StaticResource ScrollBarThumbStrokeThickness}">
                    <Rectangle.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                        </Transitions>
                    </Rectangle.Transitions>
                </Rectangle>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>

        <Style Selector="^:pointerover /template/ Rectangle#ThumbVisual">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="^:pressed /template/ Rectangle#ThumbVisual">
            <Setter Property="Opacity" Value="0.96" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#ThumbVisual">
            <Setter Property="Opacity" Value="0.25" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ScrollBarLineButton" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="Root"
                    Background="Transparent"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                    <iconPacks:IconPack
                        Name="ArrowGlyph"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}"
                        Foreground="{DynamicResource ThemeX.Foreground.Tertiary}"
                        RenderTransform="none"
                        RenderTransformOrigin="50%,50%"
                        Symbol="{TemplateBinding Content}">
                        <iconPacks:IconPack.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05" />
                                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                            </Transitions>
                        </iconPacks:IconPack.Transitions>
                    </iconPacks:IconPack>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05" />
            </Transitions>
        </Setter>

        <Style Selector="^:pointerover /template/ iconPacks|IconPack#ArrowGlyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        </Style>
        <Style Selector="^:pressed /template/ iconPacks|IconPack#ArrowGlyph">
            <Setter Property="RenderTransform" Value="scale(0.875)" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Secondary}" />
        </Style>
        <Style Selector="^:disabled /template/ iconPacks|IconPack#ArrowGlyph">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="helpers:ScrollBarAutoHideHelper.IsEnabled" Value="True" />
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarSize}" />
        <Setter Property="MinHeight" Value="{StaticResource ScrollBarSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />

        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            Name="VerticalRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Rectangle
                                    Name="TrackRect"
                                    Grid.RowSpan="3"
                                    Margin="0"
                                    Fill="{DynamicResource ThemeX.Surface.SubtleHover}"
                                    Opacity="0"
                                    RadiusX="6"
                                    RadiusY="6">
                                    <Rectangle.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                        </Transitions>
                                    </Rectangle.Transitions>
                                </Rectangle>

                                <RepeatButton
                                    Name="PART_LineUpButton"
                                    Grid.Row="0"
                                    Width="{StaticResource ScrollBarSize}"
                                    Height="{StaticResource ScrollBarSize}"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDDB;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />

                                <Track
                                    Grid.Row="1"
                                    IsDirectionReversed="True"
                                    Maximum="{TemplateBinding Maximum}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Orientation="{TemplateBinding Orientation}"
                                    ViewportSize="{TemplateBinding ViewportSize}"
                                    Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton
                                            Name="PART_PageUpButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton
                                            Name="PART_PageDownButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.IncreaseButton>
                                    <Thumb
                                        MinWidth="{StaticResource ScrollBarVerticalThumbMinWidth}"
                                        MinHeight="{StaticResource ScrollBarVerticalThumbMinHeight}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="1"
                                        RenderTransformOrigin="50%,50%"
                                        Theme="{StaticResource ScrollBarThumb}" />
                                </Track>

                                <RepeatButton
                                    Name="PART_LineDownButton"
                                    Grid.Row="2"
                                    Width="{StaticResource ScrollBarSize}"
                                    Height="{StaticResource ScrollBarSize}"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDDC;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="RenderTransform" Value="{DynamicResource VerticalSmallScrollThumbScaleTransform}" />
            </Style>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            Name="VerticalRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Rectangle
                                    Name="TrackRect"
                                    Grid.ColumnSpan="3"
                                    Margin="0"
                                    Fill="{DynamicResource ThemeX.Surface.SubtleHover}"
                                    Opacity="0"
                                    RadiusX="6"
                                    RadiusY="6">
                                    <Rectangle.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                        </Transitions>
                                    </Rectangle.Transitions>
                                </Rectangle>

                                <RepeatButton
                                    Name="PART_LineUpButton"
                                    Grid.Column="0"
                                    Width="{StaticResource ScrollBarSize}"
                                    Height="{StaticResource ScrollBarSize}"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDD9;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />

                                <Track
                                    Grid.Column="1"
                                    Maximum="{TemplateBinding Maximum}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Orientation="{TemplateBinding Orientation}"
                                    ViewportSize="{TemplateBinding ViewportSize}"
                                    Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton
                                            Name="PART_PageUpButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton
                                            Name="PART_PageDownButton"
                                            Classes="largeChange"
                                            Focusable="False"
                                            Opacity="0"
                                            Theme="{StaticResource ScrollBarPageButton}" />
                                    </Track.IncreaseButton>
                                    <Thumb
                                        MinWidth="{StaticResource ScrollBarHorizontalThumbMinWidth}"
                                        MinHeight="{StaticResource ScrollBarHorizontalThumbMinHeight}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="1"
                                        RenderTransformOrigin="50%,50%"
                                        Theme="{StaticResource ScrollBarThumb}" />
                                </Track>

                                <RepeatButton
                                    Name="PART_LineDownButton"
                                    Grid.Column="2"
                                    Width="{StaticResource ScrollBarSize}"
                                    Height="{StaticResource ScrollBarSize}"
                                    HorizontalAlignment="Center"
                                    Content="&#xEDDA;"
                                    Focusable="False"
                                    Interval="50"
                                    Opacity="0"
                                    Theme="{StaticResource ScrollBarLineButton}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="RenderTransform" Value="{DynamicResource HorizontalSmallScrollThumbScaleTransform}" />
            </Style>
        </Style>

        <Style Selector="^[AllowAutoHide=true] /template/ Grid#Root">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^.auto-hide-visible /template/ Grid#Root">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^.auto-hide-expanded, ^[AllowAutoHide=false]">
            <Style Selector="^ /template/ Rectangle#TrackRect">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ Thumb">
                <Setter Property="RenderTransform" Value="none" />
            </Style>
            <Style Selector="^ /template/ RepeatButton">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ Thumb">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
