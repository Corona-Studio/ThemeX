<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPack="clr-namespace:ThemeX.Controls.IconPacks">

    <Design.PreviewWith>
        <Panel Width="100" Height="100">
            <iconPack:IconPack
                Width="48"
                Height="48"
                Padding="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Black"
                FontSize="40"
                Foreground="White"
                Symbol="&#xE008;" />
        </Panel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type iconPack:IconPack}" TargetType="iconPack:IconPack">
        <Setter Property="FontFamily" Value="/Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons" />
    </ControlTheme>

</ResourceDictionary>
