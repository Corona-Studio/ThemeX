<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themeX="clr-namespace:ThemeX">

    <CornerRadius x:Key="SliderTrackCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="SliderThumbCornerRadius">10</CornerRadius>
    <GridLength x:Key="SliderPreContentMargin">6</GridLength>
    <GridLength x:Key="SliderPostContentMargin">6</GridLength>

    <x:Double x:Key="SliderInnerThumbHeight">12</x:Double>
    <x:Double x:Key="SliderInnerThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalHeight">32</x:Double>
    <x:Double x:Key="SliderVerticalWidth">32</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">20</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">20</x:Double>
    <x:Double x:Key="SliderVerticalThumbWidth">20</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">20</x:Double>

    <x:Double x:Key="SliderOutsideTickBarThemeHeight">4</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
    <Thickness x:Key="SliderBorderThemeThickness">0</Thickness>

    <!--  Fluent 2 Elevated Circular Thumb  -->
    <ControlTheme x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeX.Elevation.CircleBorder}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    ClipToBounds="False">
                    <Border
                        Name="ThumbOuter"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{DynamicResource ThemeX.ContentBackground.Primary}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{DynamicResource ThemeX.Shadow.Card}"
                        CornerRadius="{StaticResource SliderThumbCornerRadius}">
                        <Ellipse
                            Name="SliderInnerThumb"
                            Width="{StaticResource SliderInnerThumbWidth}"
                            Height="{StaticResource SliderInnerThumbHeight}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{TemplateBinding Background}"
                            RenderTransform="scale(0.85)"
                            RenderTransformOrigin="50%,50%">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition
                                        Easing="{StaticResource ThemeX.Easing.FluentDecelerate}"
                                        Property="RenderTransform"
                                        Duration="0:0:0.15" />
                                    <BrushTransition Property="Fill" Duration="0:0:0.12" />
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Ellipse#SliderInnerThumb">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>
        <Style Selector="^:pressed /template/ Ellipse#SliderInnerThumb">
            <Setter Property="RenderTransform" Value="scale(0.72)" />
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#SliderInnerThumb">
            <Setter Property="RenderTransform" Value="scale(0.85)" />
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="BorderThickness" Value="{StaticResource SliderBorderThemeThickness}" />
        <Setter Property="Background" Value="{DynamicResource ThemeX.ButtonBackground.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{StaticResource ThemeX.FocusAdorner.Control}" />

        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="False"
                            CornerRadius="{StaticResource SliderTrackCornerRadius}">
                            <Grid
                                Name="grid"
                                Margin="{TemplateBinding Padding}"
                                ClipToBounds="False"
                                RowDefinitions="Auto,*">
                                <Grid
                                    x:Name="SliderContainer"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    ClipToBounds="False">
                                    <Grid.Styles>
                                        <Style Selector="TickBar">
                                            <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                                        </Style>
                                    </Grid.Styles>

                                    <Grid
                                        x:Name="HorizontalTemplate"
                                        MinHeight="{StaticResource SliderHorizontalHeight}"
                                        ClipToBounds="False"
                                        ColumnDefinitions="Auto,Auto,*">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{StaticResource SliderPreContentMargin}" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="{StaticResource SliderPostContentMargin}" />
                                        </Grid.RowDefinitions>

                                        <TickBar
                                            Name="TopTickBar"
                                            Grid.ColumnSpan="3"
                                            Height="{StaticResource SliderOutsideTickBarThemeHeight}"
                                            Margin="0,0,0,4"
                                            VerticalAlignment="Bottom"
                                            Placement="Top" />

                                        <TickBar
                                            Name="BottomTickBar"
                                            Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            Height="{StaticResource SliderOutsideTickBarThemeHeight}"
                                            Margin="0,4,0,0"
                                            VerticalAlignment="Top"
                                            Placement="Bottom" />

                                        <Track
                                            Name="PART_Track"
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Margin="2,0"
                                            ClipToBounds="False"
                                            Maximum="{TemplateBinding Maximum}"
                                            Minimum="{TemplateBinding Minimum}"
                                            Orientation="Horizontal"
                                            Value="{TemplateBinding Value, Mode=TwoWay}">
                                            <Track.DecreaseButton>
                                                <RepeatButton
                                                    Name="PART_DecreaseButton"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{TemplateBinding Foreground}">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate>
                                                            <Grid>
                                                                <Border
                                                                    Name="FocusTarget"
                                                                    Margin="0,-10"
                                                                    Background="Transparent" />
                                                                <Border
                                                                    Name="TrackBackground"
                                                                    Height="{StaticResource SliderTrackThemeHeight}"
                                                                    VerticalAlignment="Center"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="{StaticResource SliderTrackCornerRadius}" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseButton>
                                            <Track.IncreaseButton>
                                                <RepeatButton
                                                    Name="PART_IncreaseButton"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{TemplateBinding Background}">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate>
                                                            <Grid>
                                                                <Border
                                                                    Name="FocusTarget"
                                                                    Margin="0,-10"
                                                                    Background="Transparent" />
                                                                <Border
                                                                    Name="TrackBackground"
                                                                    Height="{StaticResource SliderTrackThemeHeight}"
                                                                    VerticalAlignment="Center"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="{StaticResource SliderTrackCornerRadius}" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseButton>
                                            <Thumb
                                                Name="thumb"
                                                Width="{StaticResource SliderHorizontalThumbWidth}"
                                                Height="{StaticResource SliderHorizontalThumbHeight}"
                                                Margin="0"
                                                Padding="0"
                                                DataContext="{TemplateBinding Value}"
                                                Theme="{StaticResource SliderThumbStyle}" />
                                        </Track>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="False"
                            CornerRadius="{StaticResource SliderTrackCornerRadius}">
                            <Grid
                                Name="grid"
                                Margin="{TemplateBinding Padding}"
                                ClipToBounds="False"
                                RowDefinitions="Auto,*">
                                <Grid x:Name="SliderContainer" Grid.Row="1" Background="Transparent" ClipToBounds="False">
                                    <Grid.Styles>
                                        <Style Selector="TickBar">
                                            <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                                        </Style>
                                    </Grid.Styles>
                                    <Grid
                                        x:Name="VerticalTemplate"
                                        MinWidth="{StaticResource SliderVerticalWidth}"
                                        ClipToBounds="False"
                                        RowDefinitions="*,Auto,Auto">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SliderPreContentMargin}" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{StaticResource SliderPostContentMargin}" />
                                        </Grid.ColumnDefinitions>

                                        <TickBar
                                            Name="LeftTickBar"
                                            Grid.RowSpan="3"
                                            Width="{StaticResource SliderOutsideTickBarThemeHeight}"
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            Placement="Left" />

                                        <TickBar
                                            Name="RightTickBar"
                                            Grid.RowSpan="3"
                                            Grid.Column="2"
                                            Width="{StaticResource SliderOutsideTickBarThemeHeight}"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Left"
                                            Placement="Right" />

                                        <Track
                                            Name="PART_Track"
                                            Grid.RowSpan="3"
                                            Grid.Column="1"
                                            Margin="0,2"
                                            Maximum="{TemplateBinding Maximum}"
                                            Minimum="{TemplateBinding Minimum}"
                                            Orientation="Vertical"
                                            Value="{TemplateBinding Value, Mode=TwoWay}">
                                            <Track.DecreaseButton>
                                                <RepeatButton
                                                    Name="PART_DecreaseButton"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{TemplateBinding Foreground}">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate>
                                                            <Grid>
                                                                <Border
                                                                    Name="FocusTarget"
                                                                    Margin="-10,0"
                                                                    Background="Transparent" />
                                                                <Border
                                                                    Name="TrackBackground"
                                                                    Width="{StaticResource SliderTrackThemeHeight}"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="{StaticResource SliderTrackCornerRadius}" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseButton>
                                            <Track.IncreaseButton>
                                                <RepeatButton
                                                    Name="PART_IncreaseButton"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{TemplateBinding Background}">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate>
                                                            <Grid>
                                                                <Border
                                                                    Name="FocusTarget"
                                                                    Margin="-10,0"
                                                                    Background="Transparent" />
                                                                <Border
                                                                    Name="TrackBackground"
                                                                    Width="{StaticResource SliderTrackThemeHeight}"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="{StaticResource SliderTrackCornerRadius}" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseButton>
                                            <Thumb
                                                Name="SliderThumb"
                                                Width="{StaticResource SliderVerticalThumbWidth}"
                                                Height="{StaticResource SliderVerticalThumbHeight}"
                                                Margin="0"
                                                Padding="0"
                                                DataContext="{TemplateBinding Value}"
                                                Theme="{StaticResource SliderThumbStyle}" />
                                        </Track>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^ /template/ TickBar">
            <Setter Property="Fill" Value="{DynamicResource ThemeX.Foreground.Tertiary}" />
            <Setter Property="TickFrequency" Value="{TemplateBinding Slider.TickFrequency}" />
            <Setter Property="Orientation" Value="{TemplateBinding Slider.Orientation}" />
            <Setter Property="Minimum" Value="{TemplateBinding Slider.Minimum}" />
            <Setter Property="Maximum" Value="{TemplateBinding Slider.Maximum}" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Ticks" Value="{TemplateBinding Ticks}" />
        </Style>

        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:pointerover /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{DynamicResource ThemeX.ButtonBackground.Primary.MouseOver}" />
        </Style>
        <Style Selector="^:pointerover /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
        </Style>
        <Style Selector="^:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorHoverKey}}" />
        </Style>

        <Style Selector="^:pressed /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
        </Style>
        <Style Selector="^:pressed /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource {x:Static themeX:ThemeSettings.AccentColorPressedKey}}" />
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            </Style>
            <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="Background" Value="{DynamicResource ThemeX.Surface.ControlDisabled}" />
            </Style>
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            </Style>
            <Style Selector="^ /template/ TickBar">
                <Setter Property="Fill" Value="{DynamicResource ThemeX.Foreground.Disabled}" />
            </Style>
        </Style>

        <Style Selector="^:error">
            <Setter Property="Foreground" Value="{DynamicResource ThemeX.Foreground.Error}" />
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource ThemeX.Foreground.Error}" />
            </Style>
        </Style>
    </ControlTheme>

</ResourceDictionary>
