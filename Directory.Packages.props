<Project>
  <!-- Use the parent integration policy when embedded; otherwise keep standalone defaults. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="'$(ManagePackageVersionsCentrally)' != 'false'">true</ManagePackageVersionsCentrally>
    <_ThemeXParentPackages Condition="Exists('$(MSBuildThisFileDirectory)../LauncherX.slnx') And Exists('$(MSBuildThisFileDirectory)../Directory.Packages.props')">$(MSBuildThisFileDirectory)../Directory.Packages.props</_ThemeXParentPackages>
  </PropertyGroup>

  <Import Project="$(_ThemeXParentPackages)" Condition="'$(_ThemeXParentPackages)' != ''" />

  <ItemGroup Condition="'$(_ThemeXParentPackages)' == ''">
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageVersion Include="DynamicData" Version="9.4.33" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="3.1.2" />
  </ItemGroup>
</Project>
